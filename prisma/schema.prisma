generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// کاربر - احراز هویت ساده با موبایل و رمز عبور
model User {
  id              String           @id @default(cuid())
  phone           String           @unique // شماره موبایل
  password        String           // رمز عبور هش شده
  name            String           // نام نمایشی
  avatar          String?          // آواتار (JSON) - null یعنی auto
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  participants    Participant[]    // پروژه‌هایی که عضوشه
  checklists      Checklist[]      // چک‌لیست‌های شخصی (standalone)
  checklistShares ChecklistShare[] // چک‌لیست‌های به اشتراک گذاشته شده
}

model Project {
  id                    String                  @id @default(cuid())
  name                  String
  description           String?
  template              String                  @default("travel")
  splitType             String                  @default("EQUAL")
  trackingOnly          Boolean                 @default(false) // Tracking Mode (true) vs Split Mode (false) - برای template personal
  currency              String                  @default("IRR")
  chargeYear            Int?                    // سال شارژ (شمسی) - برای template ساختمان
  shareCode             String                  @unique @default(cuid())
  isArchived            Boolean                 @default(false) // آرشیو شده / بسته شده
  archivedAt            DateTime?               // تاریخ آرشیو
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  categories            Category[]
  chargeRules           ChargeRule[]
  expenses              Expense[]
  participants          Participant[]
  settlements           Settlement[]
  shoppingItems         ShoppingItem[]          // چک‌لیست خرید (برای template gathering)
  travelChecklistItems  TravelChecklistItem[]   // چک‌لیست سفر (برای template travel)
  incomes               Income[]                // درآمدها (برای template family)
  incomeCategories      IncomeCategory[]        // دسته‌بندی درآمد (برای template family)
  budgets               Budget[]                // بودجه‌های ماهانه (برای template family)
  recurringTransactions RecurringTransaction[] // تراکنش‌های تکراری (برای template family)
  accessLinks           ProjectAccessLink[]     // لینک‌های دسترسی به پروژه
}

// لینک دسترسی به پروژه - اشتراک‌گذاری با دسترسی محدود
model ProjectAccessLink {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Link identity
  token       String    @unique @default(cuid())  // توکن دسترسی عمومی
  name        String?                              // نام لینک (اختیاری): "لینک خانواده", "دسترسی دوستان"
  description String?                              // توضیحات (اختیاری)

  // Permission scopes (JSON array stored as string)
  scopes      String    @default("[]")             // دسترسی‌ها: '["expenses:read","settlements:read"]'
  role        String?                              // نقش: "viewer", "contributor", "admin"

  // Access control
  isActive    Boolean   @default(true)             // فعال / غیرفعال
  expiresAt   DateTime?                            // تاریخ انقضا (null = بدون انقضا)
  maxUses     Int?                                 // حداکثر تعداد استفاده (null = نامحدود)
  usedCount   Int       @default(0)                // تعداد دفعات استفاده شده
  lastUsedAt  DateTime?                            // آخرین بار استفاده

  // Audit
  createdByUserId String?                          // کاربری که لینک را ساخته
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([token])
  @@index([isActive])
}

model Participant {
  id                    String                  @id @default(cuid())
  name                  String
  role                  String                  @default("MEMBER")
  weight                Float                   @default(1)
  percentage            Float?
  avatar                String?                 // آواتار (JSON) - null یعنی auto
  sessionToken          String                  @unique @default(cuid())
  projectId             String
  userId                String?                 // اتصال به کاربر (اختیاری - برای مهمان‌ها null)
  scopes                String?                 // دسترسی‌های محدود از لینک (JSON): '["expenses:read","settlements:read"]' - null یعنی دسترسی کامل
  createdAt             DateTime                @default(now())
  expensesPaid            Expense[]               @relation("PaidBy")
  expenseShares           ExpenseShare[]
  settlementsFrom         Settlement[]            @relation("SettlementFrom")
  settlementsTo           Settlement[]            @relation("SettlementTo")
  shoppingItemsAdded      ShoppingItem[]          // آیتم‌های لیست خریدی که اضافه کرده
  travelChecklistItems    TravelChecklistItem[]   @relation("TravelChecklistCreator") // کارهای سفر که اضافه کرده
  incomesReceived         Income[]                @relation("IncomeReceivedBy") // درآمدهای دریافت شده (برای template family)
  recurringTransactions   RecurringTransaction[]  // تراکنش‌های تکراری این شخص
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                    User?                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([projectId])
}

model Category {
  id                    String                  @id @default(cuid())
  name                  String
  icon                  String?
  color                 String?
  projectId             String
  project               Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses              Expense[]
  budgets               Budget[]                // بودجه‌های این دسته (برای template family)
  recurringTransactions RecurringTransaction[]  // تراکنش‌های تکراری این دسته

  @@index([projectId])
}

model Expense {
  id          String         @id @default(cuid())
  title       String
  amount      Float
  description String?
  paidById    String
  categoryId  String?
  expenseDate DateTime       @default(now())
  periodKey   String?        // دوره زمانی: "1403-10" برای دی‌ماه (اختیاری - برای template ساختمان)
  receiptUrl  String?
  projectId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id])
  paidBy      Participant    @relation("PaidBy", fields: [paidById], references: [id])
  shares      ExpenseShare[]

  @@index([projectId, expenseDate(sort: Desc)])
  @@index([projectId, categoryId]) // Filter by category within project
  @@index([projectId, paidById]) // Filter by payer within project
  @@index([periodKey])
  @@index([paidById])
  @@index([categoryId]) // Queries by category
}

model ExpenseShare {
  id            String      @id @default(cuid())
  amount        Float
  weightAtTime  Float       @default(1)
  participantId String
  expenseId     String
  expense       Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([expenseId, participantId])
  @@index([participantId])
  @@index([expenseId])
}

// تسویه حساب - پرداخت بین اعضا
model Settlement {
  id                    String        @id @default(cuid())
  amount                Float         // مبلغ پرداخت شده
  fromId                String        // کسی که پول داده
  toId                  String        // کسی که پول گرفته
  projectId             String
  note                  String?       // توضیحات
  receiptUrl            String?       // تصویر رسید (اختیاری)
  status                String        @default("confirmed") // وضعیت: "pending" | "confirmed"
  type                  String        @default("normal") // نوع: "normal" | "reverse"
  reversed              Boolean       @default(false) // آیا بازگردانی شده؟
  referenceSettlementId String?       // لینک به تسویه اصلی (برای reverse)
  settledAt             DateTime      @default(now()) // تاریخ تسویه
  createdAt             DateTime      @default(now())
  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from                  Participant   @relation("SettlementFrom", fields: [fromId], references: [id])
  to                    Participant   @relation("SettlementTo", fields: [toId], references: [id])
  referenceSettlement   Settlement?   @relation("SettlementReverse", fields: [referenceSettlementId], references: [id])
  reversedBy            Settlement[]  @relation("SettlementReverse")

  @@index([projectId, settledAt(sort: Desc)])
  @@index([fromId])
  @@index([toId])
  @@index([status])
  @@index([referenceSettlementId])
}

// قاعده شارژ - تعریف پرداخت‌های دوره‌ای مورد انتظار (برای template ساختمان)
model ChargeRule {
  id          String   @id @default(cuid())
  title       String   // عنوان: "شارژ ماهیانه"، "آب‌بها"
  amount      Float    // مبلغ ثابت مورد انتظار
  frequency   String   @default("monthly") // monthly | yearly
  splitType   String   @default("WEIGHTED") // نوع تقسیم: EQUAL | WEIGHTED | PERCENTAGE
  isActive    Boolean  @default(true)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// چک‌لیست خرید - لیست خریدها برای دورهمی (فقط برای template gathering)
model ShoppingItem {
  id        String       @id @default(cuid())
  text      String       // متن آیتم (مثلاً "پیتزا پپرونی 2 عدد")
  isChecked Boolean      @default(false) // آیا خریداری شده؟
  quantity  String?      // تعداد (اختیاری)
  note      String?      // یادداشت (اختیاری)
  addedById String?      // کی اضافه کرده
  projectId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy   Participant? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, createdAt])
}

// چک‌لیست سفر - کارهای مورد نیاز برای سفر (فقط برای template travel)
model TravelChecklistItem {
  id          String       @id @default(cuid())
  text        String       // متن کار (مثلاً "خرید آب")
  status      String       @default("active") // "active" | "done"
  createdById String       // کی اضافه کرده
  completedAt DateTime?    // زمان انجام شدن
  projectId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   Participant  @relation("TravelChecklistCreator", fields: [createdById], references: [id])

  @@index([projectId, status])
  @@index([status, completedAt]) // For auto-cleanup query
}

// ═══════════════════════════════════════════════════════════════
// 👨‍👩‍👧‍👦 FAMILY FINANCE TEMPLATE MODELS
// ═══════════════════════════════════════════════════════════════

// درآمد - ثبت درآمدهای ماهانه خانواده (فقط برای template family)
model Income {
  id          String          @id @default(cuid())
  title       String          // عنوان درآمد
  amount      Float           // مبلغ
  description String?         // توضیحات
  source      String?         // منبع درآمد: "حقوق", "کسب‌وکار", "سایر"
  incomeDate  DateTime        @default(now()) // تاریخ دریافت
  categoryId  String?         // دسته‌بندی درآمد
  receivedById String         // کی دریافت کرده
  isRecurring Boolean         @default(false) // آیا تکراری است؟
  recurringId String?         // لینک به RecurringTransaction
  projectId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receivedBy  Participant     @relation("IncomeReceivedBy", fields: [receivedById], references: [id])
  category    IncomeCategory? @relation(fields: [categoryId], references: [id])

  @@index([projectId, incomeDate(sort: Desc)])
  @@index([receivedById])
  @@index([categoryId])
}

// دسته‌بندی درآمد - دسته‌بندی منابع درآمد (فقط برای template family)
model IncomeCategory {
  id        String   @id @default(cuid())
  name      String   // نام دسته: "حقوق", "کسب‌وکار", "سرمایه‌گذاری"
  icon      String?  // آیکون emoji
  color     String?  // رنگ hex
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  incomes   Income[] // درآمدهای این دسته

  @@index([projectId])
}

// بودجه ماهانه - تعیین سقف بودجه برای هر دسته خرج (فقط برای template family)
model Budget {
  id         String   @id @default(cuid())
  categoryId String   // برای کدام دسته خرج
  amount     Float    // سقف بودجه (تومان)
  periodKey  String   // دوره زمانی: "1403-10" (سال-ماه شمسی)
  projectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([projectId, categoryId, periodKey]) // یک دسته فقط یک بودجه در هر ماه
  @@index([projectId, periodKey])
}

// تراکنش تکراری - درآمد یا خرج‌های ثابت ماهانه (فقط برای template family)
model RecurringTransaction {
  id            String      @id @default(cuid())
  type          String      // نوع: "INCOME" یا "EXPENSE"
  title         String      // عنوان: "حقوق", "اجاره خانه", "قبض برق"
  amount        Float       // مبلغ ثابت
  frequency     String      // تکرار: "DAILY", "WEEKLY", "MONTHLY", "YEARLY"
  startDate     DateTime    // تاریخ شروع
  endDate       DateTime?   // تاریخ پایان (اختیاری - اگر null باشد، نامحدود)
  categoryId    String?     // دسته‌بندی (برای expense یا income)
  participantId String      // کی پرداخت/دریافت می‌کند
  isActive      Boolean     @default(true) // فعال یا غیرفعال
  lastProcessed DateTime?   // آخرین باری که process شده
  projectId     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      Category?   @relation(fields: [categoryId], references: [id])
  participant   Participant @relation(fields: [participantId], references: [id])

  @@index([projectId])
  @@index([isActive])
  @@index([participantId])
}

// ═══════════════════════════════════════════════════════════════
// ✅ STANDALONE CHECKLIST SYSTEM
// ═══════════════════════════════════════════════════════════════

// چک‌لیست - مستقل از پروژه، برای مدیریت کارها و خریدها
model Checklist {
  id          String           @id @default(cuid())
  title       String           // عنوان چک‌لیست
  description String?          // توضیحات (اختیاری)
  category    String           // دسته: "travel" | "gathering" | "personal-finance"
  icon        String?          // آیکون emoji (مثلاً "✈️")
  color       String?          // رنگ hex (مثلاً "#3b82f6")
  userId      String           // مالک چک‌لیست
  shareCode   String           @unique @default(cuid()) // کد اشتراک‌گذاری
  isPinned    Boolean          @default(false) // سنجاق شده بالای لیست
  pinnedAt    DateTime?        // تاریخ سنجاق کردن (برای مرتب‌سازی)
  isArchived  Boolean          @default(false) // آرشیو شده
  archivedAt  DateTime?        // تاریخ آرشیو
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ChecklistItem[]  // آیتم‌های چک‌لیست
  shares      ChecklistShare[] // اشتراک‌گذاری با دیگران

  @@index([userId, isArchived, createdAt(sort: Desc)]) // لیست چک‌لیست‌های فعال کاربر
  @@index([userId, category]) // فیلتر بر اساس دسته
  @@index([shareCode]) // پیدا کردن با shareCode
}

// آیتم چک‌لیست - هر کار یا خرید در چک‌لیست
model ChecklistItem {
  id          String    @id @default(cuid())
  text        String    // متن آیتم (مثلاً "خرید شیر")
  isChecked   Boolean   @default(false) // انجام شده؟
  note        String?   // یادداشت اختیاری (مثلاً "2 لیتری بگیر")
  order       Int       @default(0) // ترتیب نمایش
  checklistId String    // متعلق به کدام چک‌لیست
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, order]) // مرتب‌سازی آیتم‌ها
  @@index([checklistId, isChecked]) // فیلتر انجام شده/نشده
}

// اشتراک‌گذاری چک‌لیست - دسترسی دیگران به چک‌لیست
model ChecklistShare {
  id          String    @id @default(cuid())
  checklistId String    // کدام چک‌لیست
  userId      String?   // با کدام کاربر (null = لینک عمومی)
  permission  String    // نوع دسترسی: "VIEW" | "EDIT"
  expiresAt   DateTime? // تاریخ انقضا (null = بدون انقضا)
  createdAt   DateTime  @default(now())

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([checklistId, userId]) // هر کاربر یک دسترسی به هر چک‌لیست
  @@index([checklistId]) // اشتراک‌های یک چک‌لیست
  @@index([userId]) // چک‌لیست‌های به اشتراک گذاشته شده با یک کاربر
}
